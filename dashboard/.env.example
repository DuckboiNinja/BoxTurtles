# Relative paths resolve from the project root. Copy this file to .env.
TURTLE_DATA_DIR=./data
TURTLE_SEED_DEMO=true
TURTLE_MAX_UPLOAD_MB=1024
TURTLE_TELEMETRY_TOLERANCE_SECONDS=2
TURTLE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional for future frame ingestion clients; loopback development needs no key.
# TURTLE_INGEST_TOKEN=replace-with-a-long-random-token
